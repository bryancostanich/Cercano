# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/


# Mac stuff
**/.DS_STORE
source/server/bin/
source/clients/cli/bin/
source/server/agent
scratch/
test/sandbox/

# Brainstorm/visual-companion session artifacts (per-session, regenerated)
.superpowers/

# Linked git worktrees. Each subdirectory is a git worktree checkout
# managed by the git_worktree tool — see the worktree-first protocol.
# Excluded so their internal HEAD drift and the worktree directories
# themselves do not show up in the root worktree's status.
.claude/worktrees/
source/server/compaction-bakeoff
source/server/cercano

# Developer-local MCP host config (machine-specific absolute binary path).
# Copy .mcp.json.example to .mcp.json and set the command path for your machine.
.mcp.json

# Local databases (conversations, telemetry, etc.)
*.db
